print ("welcome to catuc pos")
num_item=int(input("please enter the number of items purchased:"))
items=[]
grand_total=0
for item in range(1,num_item +1):
    print("\nitem",item)
    name=input("enter item name:")
    quantity=int(input("enter quantity:"))
    unit_price=float(input("enter unit_price:"))
    total_price =quantity*unit_price
    items.append([name,quantity,unit_price,total_price])
    grand_total+=total_price
if len(items)>5 and grand_total>4000:
    discount=0.15*grand_total
elif grand_total>5000:
    discount=0.10*grand_total
else:
    discount=0
total_cost=grand_total-discount
print("\n")
print("\ncatuc pos reciept")
print(f"{'s/n':<5}{'description':<15}{'quantity':<12}{'unitprice':<15}{'totalprice':15}")
      
for i,item in enumerate(items,start=1):
      print(f"{i:5}{item[0]:<15}{item[1]:<12}{item[2]:<15.2f}{item[3]:<15.2f}")
print("\n total expenditure:",grand_total,"fcfa")
print("discount:",discount,"fcfa")
print ("final amount:",total_cost,"fcfa")
print ("thanks ")

