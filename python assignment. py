print("multiplication table")

number=int(input("enter a number:"))
limit=int(input("enter the limit:"))

for i in range (1,limit + 1):
  answer =number*i
  print(number,"*",i,"=",answer)
print("division table")
for i in range (1,limit +1):
  answer=number/i
  print(number,"/",i,"=",answer)
